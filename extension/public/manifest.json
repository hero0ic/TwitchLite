{
  "manifest_version": 3,
  "name": "TwitchLite",
  "version": "0.1.0",
  "description": "A lightweight Twitch viewer focused on reducing unnecessary browser resource usage.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "TwitchLite",
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["chat-content.js"],
      "all_frames": true
    }
  ],
  "host_permissions": ["https://twitchlite.app/*"]
}
